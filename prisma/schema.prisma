generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  Int
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
} 


model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(user)
} 


enum Role {
  user
  writer
  admin
}
